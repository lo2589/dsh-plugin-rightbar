{
  "name": "dsh-plugin-rightbar",
  "version": "0.1.0",
  "private": true,
  "description": "A shared right sidebar for dsh: one column beside Chat, plugins contribute tabs into the `rightbar.tab` slot instead of each floating its own fixed panel.",
  "type": "commonjs",
  "main": "src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json",
    "./skill": "./src/skill.js"
  },
  "files": [
    "src",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web",
    "layout",
    "sidebar",
    "slot"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lo2589/dsh-plugin-rightbar.git"
  },
  "homepage": "https://github.com/lo2589/dsh-plugin-rightbar#readme",
  "bugs": {
    "url": "https://github.com/lo2589/dsh-plugin-rightbar/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
